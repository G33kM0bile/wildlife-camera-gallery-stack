# Bind the public-facing ports to the intended interface.
PIGALLERY_BIND=127.0.0.1
PIGALLERY_PORT=8081
SFTPGO_SFTP_BIND=0.0.0.0
SFTPGO_SFTP_PORT=2022
SFTPGO_WEB_BIND=127.0.0.1
SFTPGO_WEB_PORT=8080

# Keep image versions pinned until an upgrade has been tested.
PIGALLERY_IMAGE=bpatrik/pigallery2:latest
SFTPGO_IMAGE=drakkan/sftpgo:2.7.x

# Host paths.
PHOTO_ROOT=/srv/sftpgo/data
PHOTO_ROOT_PARENT=/srv/sftpgo
PIGALLERY_ROOT=/opt/pigallery2
SFTPGO_STATE=/var/lib/sftpgo
