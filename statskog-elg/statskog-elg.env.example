# Statskog public ArcGIS endpoint. No credentials are required for this source.
STATSKOG_ARCGIS_URL=https://kartportal.statskog.no/server/rest/services/Storvilt_2024/Storvilt_app_innsyn/MapServer
STATSKOG_LAYER=0
STATSKOG_JAKTFELT_LAYER=4
STATSKOG_JAKTLAG_LAYER=8
JAKTFELT_ID=1840J0096
JAKTFELT_NAME=Storjord Øst
ART=Elg

# Existing InfluxDB v2 installation.
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=replace-with-write-only-token
INFLUX_ORG=Minsin
INFLUX_BUCKET=Wildlife

# Normally supplied by systemd's StateDirectory.
STATE_FILE=/var/lib/statskog-elg/state.json
HTTP_TIMEOUT_SECONDS=30
ARCGIS_PAGE_SIZE=1000
INFLUX_BATCH_SIZE=500
LOCAL_TIMEZONE=Europe/Oslo
