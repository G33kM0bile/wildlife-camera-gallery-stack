CAMERA_ADMIN_SECURE_COOKIE=1
CAMERA_ADMIN_OIDC_ISSUER=https://auth.example.com/auth/v1
CAMERA_ADMIN_OIDC_CLIENT_ID=kamera
CAMERA_ADMIN_OIDC_CLIENT_SECRET_FILE=/etc/viltkamera-camera-admin/oidc-client-secret
CAMERA_ADMIN_OIDC_REDIRECT_URI=https://kamera.example.com/auth/oidc/callback
CAMERA_ADMIN_OIDC_SCOPES=openid profile email groups
CAMERA_ADMIN_OIDC_ALLOWED_USERS=
CAMERA_ADMIN_OIDC_ALLOWED_GROUPS=hunters,admin
