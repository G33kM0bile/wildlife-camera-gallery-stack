[Unit]
Description=Viltkamera SFTPGo browser portal routing
After=network.target sftpgo.service
Requires=sftpgo.service

[Service]
User=nobody
Group=nogroup
StateDirectory=viltkamera-sftpgo-proxy
StateDirectoryMode=0700
Environment=HOME=/var/lib/viltkamera-sftpgo-proxy
ExecStart=/usr/bin/caddy run --config /etc/viltkamera-sso/Caddyfile --adapter caddyfile
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
