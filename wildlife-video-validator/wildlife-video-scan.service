[Unit]
Description=Scan existing wildlife-camera MP4 files
After=sftpgo.service

[Service]
Type=oneshot
User=sftpgo
Group=sftpgo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wildlife-ocr/venv/bin/python /opt/wildlife-video-validator/video_validator.py --scan
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sftpgo/data /srv/sftpgo/quarantine
