[Unit]
Description=Add wildlife camera location metadata to uploaded photos
After=local-fs.target sftpgo.service
RequiresMountsFor=/srv/sftpgo/data

[Service]
Type=simple
User=sftpgo
Group=sftpgo
ExecStart=/usr/local/sbin/viltkamera-metadata-watch
Restart=always
RestartSec=3
Nice=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/sftpgo/data

[Install]
WantedBy=multi-user.target
